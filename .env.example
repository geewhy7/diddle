# Diddle — environment variable template
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.

# ── Telegram ───────────────────────────────────────────────────────────────────

# Bot token from @BotFather → /newbot
TELEGRAM_TOKEN=

# Mini App short name registered with BotFather (used to build t.me links)
BOT_APP_NAME=diddle

# Full HTTPS URL where the Mini App frontend is served (via Cloudflare tunnel)
GAME_URL=https://diddle.retard.zone

# ── Backend ────────────────────────────────────────────────────────────────────

# SQLite database file path (relative to backend/ working directory)
DB_PATH=./diddle.db

# Internal URL the bot uses to call the backend API (no trailing slash)
BACKEND_URL=http://localhost:7113

# Allowed CORS origin — must match GAME_URL in production
CORS_ORIGIN=https://diddle.retard.zone

# ── Difficulty ─────────────────────────────────────────────────────────────────
# All env changes require a restart of the relevant process:
#   backend → sudo systemctl restart diddle-backend
#   bot     → restart in tmux session "clown"
# WARNING: changing a range and restarting mid-day RE-ROLLS that day's puzzle —
# late submitters against the old puzzle will be rejected. Prefer changing
# these after midnight.

# Regular daily puzzle: optimal path length range (defaults 4-7)
PUZZLE_MIN_STEPS=4
PUZZLE_MAX_STEPS=7

# Wicked Wednesday challenge: optimal path length range (defaults 9-15;
# falls back to 6-12 automatically if no word pair fits the range)
CHALLENGE_MIN_STEPS=9
CHALLENGE_MAX_STEPS=15

# Challenge word pool = regular words ∩ wordfreq top-N (default 20000).
# Smaller N → more common words in challenge chains; larger N → more obscure.
CHALLENGE_FREQ_TOP_N=20000

# ── Toggles ────────────────────────────────────────────────────────────────────

# Set to true ONLY for local testing without a real Telegram initData.
# MUST be false in production.
DEV_SKIP_AUTH=false

# Force challenge mode on any day (normally only active on Wednesdays).
FORCE_CHALLENGE=false
