# Diddle — environment variable template
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.

# ── Telegram ───────────────────────────────────────────────────────────────────

# Bot token from @BotFather → /newbot
TELEGRAM_TOKEN=

# Mini App short name registered with BotFather (used to build t.me links)
BOT_APP_NAME=diddle

# Full HTTPS URL where the Mini App frontend is served (via Cloudflare tunnel)
GAME_URL=https://diddle.retard.zone

# ── Backend ────────────────────────────────────────────────────────────────────

# SQLite database file path (relative to backend/ working directory)
DB_PATH=./diddle.db

# Internal URL the bot uses to call the backend API (no trailing slash)
BACKEND_URL=http://localhost:7113

# Allowed CORS origin — must match GAME_URL in production
CORS_ORIGIN=https://diddle.retard.zone

# Set to true ONLY for local testing without a real Telegram initData.
# MUST be false in production.
DEV_SKIP_AUTH=false
