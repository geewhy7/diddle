# Word Ladder — environment variable template
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.

# ── Telegram ───────────────────────────────────────────────────────────────────

# Bot token from @BotFather → /newbot
TELEGRAM_TOKEN=

# Game short name from @BotFather → /newgame (e.g. wordladder)
GAME_SHORT_NAME=

# Full HTTPS URL where the Mini App frontend is served
# Must match what you set in BotFather → /setgameurl
GAME_URL=https://yourdomain.com

# ── Backend ────────────────────────────────────────────────────────────────────

# Port for uvicorn to listen on (Nginx proxies to this)
BACKEND_PORT=8000

# Full path to the SQLite database file
DB_PATH=/var/www/word-ladder/word_ladder.db

# Allowed origin for CORS — should match GAME_URL
CORS_ORIGIN=https://yourdomain.com

# ── Game ───────────────────────────────────────────────────────────────────────

# Number of letters in the puzzle words (4 or 5)
WORD_LENGTH=5

# Difficulty range: min and max steps for the daily puzzle
PUZZLE_MIN_STEPS=4
PUZZLE_MAX_STEPS=7
